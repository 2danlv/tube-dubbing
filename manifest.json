{
   "action": {
      "default_icon": {
         "16": "icon/16x16.png",
         "32": "icon/32x32.png",
         "64": "icon/64x64.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "utils/parser.js", "utils/normalizer.js", "utils/timing.js", "utils/segmenter.js", "content.js" ],
      "matches": [ "https://*.youtube.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "inject.js" ],
      "matches": [ "https://*.youtube.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   } ],
   "default_locale": "vi",
   "description": "__MSG_extensionDescription__",
   "host_permissions": [
      "https://*.youtube.com/*",
      "https://generativelanguage.googleapis.com/*",
      "https://dev.microsofttranslator.com/*",
      "https://*.tts.speech.microsoft.com/*"
   ],
   "icons": {
      "16": "icon/16x16.png",
      "32": "icon/32x32.png",
      "64": "icon/64x64.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extensionName__",
   "permissions": [ "activeTab", "storage" ],
   "version": "2.4.14"
}
